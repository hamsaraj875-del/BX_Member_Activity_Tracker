# MongoDB Connection URI
# Option 1 - Local MongoDB (default):
MONGODB_URI=mongodb://127.0.0.1:27017/bx_analytics

# Option 2 - MongoDB Atlas (replace with your cluster URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bx_analytics?retryWrites=true&w=majority

# Express Server Port
PORT=3001
